# ========================================================
# LOCAL DEVELOPMENT CONFIGURATION (DOCKER COMPOSE)
# ========================================================

# API Configuration
PROJECT_NAME="Multi-Tenant RAG API"
VERSION="0.1.0"

# Local PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=rag_platform

# Local Redis / Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Local Qdrant Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Gemini API Key (Required for LLM Generation)
GEMINI_API_KEY="your_gemini_api_key_here"


# ========================================================
# PRODUCTION DEPLOYMENT CONFIGURATION (RENDER / SUPABASE)
# ========================================================

# Set this to the external Supabase Connection URI
# DATABASE_URI="postgresql://postgres.[YOUR-ID]:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Set these to the Internal Redis URL provided by Render Key Value
# CELERY_BROKER_URL="redis://red-[YOUR-ID]:6379"
# CELERY_RESULT_BACKEND="redis://red-[YOUR-ID]:6379"

# Set these to the Qdrant Cloud URL and API Key
# QDRANT_URL="https://[YOUR-CLUSTER-ID].REGION.aws.cloud.qdrant.io:6333"
# QDRANT_API_KEY="your_qdrant_cloud_api_key"

# CORS configuration to only allow requests from your Vercel frontend
# CORS_ORIGINS="https://your-frontend.vercel.app"
